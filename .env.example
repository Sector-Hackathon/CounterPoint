# Sectors API (https://sectors.app) — server-side only, never expose to the web app
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v2

# LLM provider for claim extraction, planner and interpretation: anthropic | openai
# Leave the selected provider's key empty to run with the offline heuristic extractor + deterministic planner.
LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Database
DATABASE_URL=postgresql://counterpoint:counterpoint@localhost:5433/counterpoint

# API (hosts like Railway set PORT, which takes precedence over API_PORT)
API_PORT=4000
# Comma-separated list of allowed web origins, e.g. https://counterpoint.vercel.app
WEB_ORIGIN=http://localhost:3005
# Public-demo protection: per-IP theses per hour, and total new theses per UTC day
RATE_LIMIT_PER_HOUR=10
DAILY_THESIS_CAP=200

# Web
FRONTEND_PORT=3005
NEXT_PUBLIC_API_URL=http://localhost:4000
# Hard per-session investigation limit (NFR-005)
SESSION_DEADLINE_MS=90000
