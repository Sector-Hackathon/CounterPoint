# Sectors API (https://sectors.app) — server-side only, never expose to the web app
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v1

# LLM provider for claim extraction, planner and interpretation: anthropic | openai
# Leave the selected provider's key empty to run with the offline heuristic extractor + deterministic planner.
LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Database
DATABASE_URL=postgresql://counterpoint:counterpoint@localhost:5433/counterpoint

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
