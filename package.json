{
  "name": "counterpoint",
  "private": true,
  "version": "0.1.0",
  "description": "AI evidence investigation agent for Indonesian stock narratives",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "dev:api": "pnpm --filter @counterpoint/api dev",
    "dev:web": "pnpm --filter @counterpoint/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "eval": "pnpm --filter @counterpoint/eval eval",
    "sectors:probe": "tsx scripts/sectors-probe.ts",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
